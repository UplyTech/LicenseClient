{
  "formatVersion": 1,
  "description": "Deterministic JSON serialisation: keys sorted by code point, no whitespace, unicode left as UTF-8. Generated by app/core/license_signing.py:canonical_json in the API, which is the authority.",
  "notes": [
    "Floating point numbers are deliberately absent, and both editions must refuse them. Python writes 1.0 where JavaScript writes 1, and no amount of care fixes that in general. Licence payloads only ever carry strings, integers, booleans, null, arrays and objects.",
    "The client never re-serialises a payload in order to verify it - it verifies the decoded bytes. This format exists so that both editions can produce a request body, a cache blob and a debugging dump that match."
  ],
  "cases": [
    {
      "id": "empty-object",
      "value": {},
      "expect": "{}",
      "expectBytesBase64": "e30="
    },
    {
      "id": "keys-are-sorted",
      "why": "Insertion order must not survive. This is the whole point of the format.",
      "value": {
        "b": 1,
        "a": 2,
        "c": 3
      },
      "expect": "{\"a\":2,\"b\":1,\"c\":3}",
      "expectBytesBase64": "eyJhIjoyLCJiIjoxLCJjIjozfQ=="
    },
    {
      "id": "no-whitespace",
      "value": {
        "a": 1,
        "b": [
          1,
          2,
          3
        ]
      },
      "expect": "{\"a\":1,\"b\":[1,2,3]}",
      "expectBytesBase64": "eyJhIjoxLCJiIjpbMSwyLDNdfQ=="
    },
    {
      "id": "nested",
      "value": {
        "outer": {
          "z": 1,
          "a": {
            "y": 2,
            "b": 3
          }
        }
      },
      "expect": "{\"outer\":{\"a\":{\"b\":3,\"y\":2},\"z\":1}}",
      "expectBytesBase64": "eyJvdXRlciI6eyJhIjp7ImIiOjMsInkiOjJ9LCJ6IjoxfX0="
    },
    {
      "id": "null-and-booleans",
      "why": "JSON null is not the empty string, and false is not 0.",
      "value": {
        "nothing": null,
        "yes": true,
        "no": false
      },
      "expect": "{\"no\":false,\"nothing\":null,\"yes\":true}",
      "expectBytesBase64": "eyJubyI6ZmFsc2UsIm5vdGhpbmciOm51bGwsInllcyI6dHJ1ZX0="
    },
    {
      "id": "empty-array-and-object",
      "value": {
        "list": [],
        "map": {}
      },
      "expect": "{\"list\":[],\"map\":{}}",
      "expectBytesBase64": "eyJsaXN0IjpbXSwibWFwIjp7fX0="
    },
    {
      "id": "unicode-is-not-escaped",
      "why": "ensure_ascii=False. The bytes carry UTF-8, not \\u sequences - the two editions would otherwise disagree on the escape casing.",
      "value": {
        "name": "Grüße",
        "emoji": "🔑"
      },
      "expect": "{\"emoji\":\"🔑\",\"name\":\"Grüße\"}",
      "expectBytesBase64": "eyJlbW9qaSI6IvCflJEiLCJuYW1lIjoiR3LDvMOfZSJ9"
    },
    {
      "id": "key-sorting-is-by-code-point",
      "why": "JavaScript's default sort compares UTF-16 code units, which puts characters outside the basic plane in the wrong place. Python sorts by code point. The TypeScript edition has to sort by code point too.",
      "value": {
        "🔑": 1,
        "￿": 2,
        "a": 3
      },
      "expect": "{\"a\":3,\"￿\":2,\"🔑\":1}",
      "expectBytesBase64": "eyJhIjozLCLvv78iOjIsIvCflJEiOjF9"
    },
    {
      "id": "characters-that-must-be-escaped",
      "why": "Quote, backslash and the control characters stay escaped even with ensure_ascii=False.",
      "value": {
        "quote": "\"",
        "backslash": "\\",
        "newline": "\n",
        "tab": "\t"
      },
      "expect": "{\"backslash\":\"\\\\\",\"newline\":\"\\n\",\"quote\":\"\\\"\",\"tab\":\"\\t\"}",
      "expectBytesBase64": "eyJiYWNrc2xhc2giOiJcXCIsIm5ld2xpbmUiOiJcbiIsInF1b3RlIjoiXCIiLCJ0YWIiOiJcdCJ9"
    },
    {
      "id": "integers-keep-their-shape",
      "value": {
        "zero": 0,
        "negative": -17,
        "big": 9007199254740991
      },
      "expect": "{\"big\":9007199254740991,\"negative\":-17,\"zero\":0}",
      "expectBytesBase64": "eyJiaWciOjkwMDcxOTkyNTQ3NDA5OTEsIm5lZ2F0aXZlIjotMTcsInplcm8iOjB9"
    },
    {
      "id": "a-realistic-licence-payload",
      "why": "The shape that is actually signed.",
      "value": {
        "v": 1,
        "license_id": "lic_2f8a1c",
        "product": "teampromanager",
        "product_id": 5,
        "subject": {
          "type": "tenant",
          "ref": "1"
        },
        "seat_id": 42,
        "device_fingerprint": "0da041751176c4024de409802c69467bd2a47366c705815dc3acc5339b1a873d",
        "type": "subscription",
        "tier": "pro",
        "status": "active",
        "features": [
          "teams",
          "tasks",
          "time_tracking"
        ],
        "seat_limit": 5,
        "seats_used": 2,
        "issued_at": "2026-03-01T09:00:00+00:00",
        "not_before": "2026-01-01T00:00:00+00:00",
        "expires_at": "2026-12-31T23:59:59+00:00",
        "offline_valid_until": "2026-03-08T09:00:00+00:00",
        "grace_period_days": 7,
        "next_check_after": "2026-03-01T21:00:00+00:00",
        "max_version": null,
        "server_time": "2026-03-01T09:00:00+00:00",
        "nonce": "nonce-0123456789"
      },
      "expect": "{\"device_fingerprint\":\"0da041751176c4024de409802c69467bd2a47366c705815dc3acc5339b1a873d\",\"expires_at\":\"2026-12-31T23:59:59+00:00\",\"features\":[\"teams\",\"tasks\",\"time_tracking\"],\"grace_period_days\":7,\"issued_at\":\"2026-03-01T09:00:00+00:00\",\"license_id\":\"lic_2f8a1c\",\"max_version\":null,\"next_check_after\":\"2026-03-01T21:00:00+00:00\",\"nonce\":\"nonce-0123456789\",\"not_before\":\"2026-01-01T00:00:00+00:00\",\"offline_valid_until\":\"2026-03-08T09:00:00+00:00\",\"product\":\"teampromanager\",\"product_id\":5,\"seat_id\":42,\"seat_limit\":5,\"seats_used\":2,\"server_time\":\"2026-03-01T09:00:00+00:00\",\"status\":\"active\",\"subject\":{\"ref\":\"1\",\"type\":\"tenant\"},\"tier\":\"pro\",\"type\":\"subscription\",\"v\":1}",
      "expectBytesBase64": ""
    }
  ]
}
