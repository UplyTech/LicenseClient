{
  "formatVersion": 1,
  "description": "Licence key format: Crockford base32 without I, L, O and U, fifteen body symbols and a Luhn mod 32 check symbol. Generated by app/core/license_keys.py in the API.",
  "notes": [
    "The check symbol is what lets a client reject a typo without a network round trip - and without an endpoint that answers 'no such key', which would be a key oracle.",
    "The check symbol is computed over productCode + body, not over the display form: the brand prefix is stripped first."
  ],
  "alphabet": "0123456789ABCDEFGHJKMNPQRSTVWXYZ",
  "brandPrefix": "ULT",
  "bodySymbols": 15,
  "validKeys": [
    {
      "id": "TPM-3F7K9",
      "productCode": "TPM",
      "body": "3F7K92QW8MXZ4RB",
      "checkSymbol": "W",
      "display": "ULT-TPM-3F7K9-2QW8M-XZ4RB-W",
      "normalised": "TPM3F7K92QW8MXZ4RBW"
    },
    {
      "id": "TPM-00000",
      "productCode": "TPM",
      "body": "000000000000000",
      "checkSymbol": "5",
      "display": "ULT-TPM-00000-00000-00000-5",
      "normalised": "TPM0000000000000005"
    },
    {
      "id": "FTX-ZZZZZ",
      "productCode": "FTX",
      "body": "ZZZZZZZZZZZZZZZ",
      "checkSymbol": "E",
      "display": "ULT-FTX-ZZZZZ-ZZZZZ-ZZZZZ-E",
      "normalised": "FTXZZZZZZZZZZZZZZZE"
    },
    {
      "id": "VBT-12345",
      "productCode": "VBT",
      "body": "1234567890ABCDE",
      "checkSymbol": "F",
      "display": "ULT-VBT-12345-67890-ABCDE-F",
      "normalised": "VBT1234567890ABCDEF"
    },
    {
      "id": "WTG-HJKMN",
      "productCode": "WTG",
      "body": "HJKMNPQRSTVWXYZ",
      "checkSymbol": "F",
      "display": "ULT-WTG-HJKMN-PQRST-VWXYZ-F",
      "normalised": "WTGHJKMNPQRSTVWXYZF"
    },
    {
      "id": "TPM-01010",
      "productCode": "TPM",
      "body": "01010101010101H",
      "checkSymbol": "V",
      "display": "ULT-TPM-01010-10101-0101H-V",
      "normalised": "TPM01010101010101HV"
    }
  ],
  "normaliseCases": [
    {
      "id": "already-canonical",
      "input": "ULT-TPM-3F7K9-2QW8M-XZ4RB-W",
      "expect": "TPM3F7K92QW8MXZ4RBW"
    },
    {
      "id": "lower-case",
      "why": "Keys are read off a screen and typed back in.",
      "input": "ult-tpm-3f7k9-2qw8m-xz4rb-w",
      "expect": "TPM3F7K92QW8MXZ4RBW"
    },
    {
      "id": "spaces-instead-of-dashes",
      "input": "ULT TPM 3F7K9 2QW8M XZ4RB W",
      "expect": "TPM3F7K92QW8MXZ4RBW"
    },
    {
      "id": "no-separators-at-all",
      "input": "ULTTPM3F7K92QW8MXZ4RBW",
      "expect": "TPM3F7K92QW8MXZ4RBW"
    },
    {
      "id": "without-the-brand-prefix",
      "why": "ULT is decoration. A key typed without it still resolves - the prefix contains U and L, which the alphabet excludes, so it is stripped rather than folded.",
      "input": "TPM-3F7K9-2QW8M-XZ4RB-W",
      "expect": "TPM3F7K92QW8MXZ4RBW"
    },
    {
      "id": "confusable-letters",
      "why": "I and L read as 1, O as 0, U as V. Somebody reading a key aloud cannot get this wrong. Built from a key that actually contains 0 and 1, so the substitution has something to bite on.",
      "input": "ULT-TPM-OIOIO-IOIOI-OIOIH-V",
      "expect": "TPM01010101010101HV"
    },
    {
      "id": "surrounding-noise",
      "input": "  ULT-TPM-3F7K9-2QW8M-XZ4RB-W\n",
      "expect": "TPM3F7K92QW8MXZ4RBW"
    }
  ],
  "invalidKeys": [
    {
      "id": "empty",
      "input": "",
      "why": "Nothing typed yet.",
      "expectError": "LicenseKeyError",
      "message": "Key is too short"
    },
    {
      "id": "too-short",
      "input": "ULT-TPM-3F7K9",
      "why": "A partially pasted key.",
      "expectError": "LicenseKeyError",
      "message": "Key is too short"
    },
    {
      "id": "one-wrong-character",
      "input": "ULT-TPM-3F7K9-2QW8M-XZ4RC-7",
      "why": "The single most common typo. The check symbol catches it offline, with no round trip and without telling anybody whether the key exists.",
      "expectError": "LicenseKeyError",
      "message": "Key check symbol does not match - likely a typo"
    },
    {
      "id": "transposed-pair",
      "input": "ULT-TPM-3F7K9-2QW8M-XZ4BR-7",
      "why": "Two adjacent symbols swapped - the second most common typo.",
      "expectError": "LicenseKeyError",
      "message": "Key check symbol does not match - likely a typo"
    },
    {
      "id": "wrong-check-symbol",
      "input": "ULT-TPM-3F7K9-2QW8M-XZ4RB-8",
      "why": "Body intact, check symbol changed.",
      "expectError": "LicenseKeyError",
      "message": "Key check symbol does not match - likely a typo"
    },
    {
      "id": "body-too-long",
      "input": "ULT-TPM-3F7K9-2QW8M-XZ4RB-XX-7",
      "why": "A product code longer than four characters is implausible.",
      "expectError": "LicenseKeyError",
      "message": "Key has an implausible product code length"
    }
  ]
}
