{
  "name": "@uplytech/license-client",
  "version": "2.0.0",
  "description": "Client half of the UplyTech licence system: offline key validation, device fingerprinting, activation, heartbeat, Ed25519-signed answers and an encrypted offline cache. One activation per computer, and a grace period that survives a flight.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests examples",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "license",
    "licence",
    "licensing",
    "activation",
    "device-fingerprint",
    "ed25519",
    "offline",
    "electron",
    "uplytech"
  ],
  "author": "UplyTech <dev@uplytech.de>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UplyTech/LicenseClient.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/UplyTech/LicenseClient/issues"
  },
  "homepage": "https://github.com/UplyTech/LicenseClient#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
